static func rect_for(character_id: StringName, sprite_frame: Vector3i) -> Rect2:
	var bounds := REN_BOUNDS if character_id == &"ren" else VEL_BOUNDS
	if character_id != &"ren" and character_id != &"vel":
		return Rect2()
	if (
		sprite_frame.x < 0
		or sprite_frame.x >= SHEETS_PER_CHARACTER
		or sprite_frame.y < 0
		or sprite_frame.y >= COLUMNS_PER_ROW
		or sprite_frame.z < 0
		or sprite_frame.z >= ROWS_PER_SHEET
	):
		return Rect2()
	var frame_index := (
		(sprite_frame.x * ROWS_PER_SHEET + sprite_frame.z) * COLUMNS_PER_ROW
		+ sprite_frame.y
	)
	var value_index := frame_index * VALUES_PER_FRAME
	if value_index < 0 or value_index + VALUES_PER_FRAME > bounds.size():
		return Rect2()
	var left := float(bounds[value_index])
	var top := float(bounds[value_index + 1])
	var right := float(bounds[value_index + 2])
	var bottom := float(bounds[value_index + 3])
	return Rect2(left, top, right - left, bottom - top)
